generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Market {
  id          String   @id @default(cuid())
  question    String
  description String?
  closesAt    DateTime
  yesPrice    Float    @default(50)
  noPrice     Float    @default(50)
  resolved    Boolean  @default(false)
  outcome     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  trades      Trade[]
}

model Trade {
  id        String   @id @default(cuid())
  marketId  String
  side      String
  amount    Float
  price     Float
  createdAt DateTime @default(now())
  market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
}